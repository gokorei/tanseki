ALTER TABLE documents RENAME TO documents_legacy;

CREATE TABLE documents (
    id           TEXT    NOT NULL PRIMARY KEY,
    collection   TEXT    NOT NULL,
    path         TEXT    NOT NULL,
    frontmatter  TEXT    NOT NULL DEFAULT '{}',
    content      TEXT    NOT NULL,
    content_hash TEXT    NOT NULL,
    revision     TEXT    NOT NULL,
    updated_at   INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0,
    UNIQUE (collection, path)
);

INSERT INTO documents(
    id, collection, path, frontmatter, content, content_hash, revision, updated_at, deleted
)
SELECT id, collection, path, frontmatter, content, content_hash, revision, updated_at, deleted
FROM documents_legacy;

DROP TABLE documents_legacy;

CREATE INDEX documents_collection_idx ON documents(collection);
